table fact_asydcfstq
	lineageTag: d1670db0-ca5d-4672-b8cc-d7be522b7744
	sourceLineageTag: [gold].[fact_asydcfstq]

	measure 'Total Decisions (TOTAL)' =
			
			CALCULATE(
			    SUM('fact_asydcfstq'[decision_count]),
			    'fact_asydcfstq'[decision] = "TOTAL",
			    'fact_asydcfstq'[country_name] = "European Union - 27 countries",
			    'fact_asydcfstq'[country_code] = "EU27_2020",
			    'fact_asydcfstq'[nationality_code] = "EXT_EU27_2020")
		formatString: 0
		lineageTag: 27942970-c9ef-4328-b762-cf983c63fad6

		changedProperty = Name

	measure 'Total Decisions (Analytical)' =
			
			CALCULATE(
			    SUM('fact_asydcfstq'[decision_count]),
			    'fact_asydcfstq'[decision] <> "TOTAL",
			    'fact_asydcfstq'[country_name] <> "European Union - 27 countries",
			    'fact_asydcfstq'[country_code] <> "EU27_2020",
			     'fact_asydcfstq'[nationality_code] <> "EXT_EU27_2020")
		formatString: 0
		lineageTag: 1a448c41-4687-40a3-832b-53fccc70afdf

		changedProperty = Name

	measure 'Total Decisions (Page 3)' =
			
			VAR IsCountryFiltered = ISFILTERED('fact_asydcfstq'[country_name])
			VAR IsNationalityFiltered = ISFILTERED('fact_asydcfstq'[nationality_code])
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsCountryFiltered && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asydcfstq'[decision_count]),
			            'fact_asydcfstq'[decision] = "TOTAL",
			            KEEPFILTERS('fact_asydcfstq'[country_code] <> "EU27_2020"),
			            KEEPFILTERS('fact_asydcfstq'[nationality_code] <> "EXT_EU27_2020")
			        ),
			    IsCountryFiltered && NOT(IsNationalityFiltered),
			        CALCULATE(
			            SUM('fact_asydcfstq'[decision_count]),
			            'fact_asydcfstq'[decision] = "TOTAL",
			            KEEPFILTERS('fact_asydcfstq'[country_code] <> "EU27_2020"),
			            'fact_asydcfstq'[nationality_code] = "EXT_EU27_2020"
			        ),
			    NOT(IsCountryFiltered) && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asydcfstq'[decision_count]),
			            'fact_asydcfstq'[decision] = "TOTAL",
			            'fact_asydcfstq'[country_code] = "EU27_2020",
			            KEEPFILTERS('fact_asydcfstq'[nationality_code] <> "EXT_EU27_2020")
			        ),
			    CALCULATE(
			        SUM('fact_asydcfstq'[decision_count]),
			        'fact_asydcfstq'[decision] = "TOTAL",
			        'fact_asydcfstq'[country_code] = "EU27_2020",
			        'fact_asydcfstq'[nationality_code] = "EXT_EU27_2020"
			    )
			)
		formatString: 0
		lineageTag: ce0cb2f3-38ec-4c81-9d21-6110167c9e43

		changedProperty = Name

	measure 'Positive Decisions' =
			
			VAR IsCountryFiltered = ISFILTERED('fact_asydcfstq'[country_name])
			VAR IsNationalityFiltered = ISFILTERED('fact_asydcfstq'[nationality_code])
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsCountryFiltered && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asydcfstq'[decision_count]),
			            'fact_asydcfstq'[decision] = "POS",
			            KEEPFILTERS('fact_asydcfstq'[country_code] <> "EU27_2020"),
			            KEEPFILTERS('fact_asydcfstq'[nationality_code] <> "EXT_EU27_2020")
			        ),
			    IsCountryFiltered && NOT(IsNationalityFiltered),
			        CALCULATE(
			            SUM('fact_asydcfstq'[decision_count]),
			            'fact_asydcfstq'[decision] = "POS",
			            KEEPFILTERS('fact_asydcfstq'[country_code] <> "EU27_2020"),
			            'fact_asydcfstq'[nationality_code] = "EXT_EU27_2020"
			        ),
			    NOT(IsCountryFiltered) && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asydcfstq'[decision_count]),
			            'fact_asydcfstq'[decision] = "POS",
			            'fact_asydcfstq'[country_code] = "EU27_2020",
			            KEEPFILTERS('fact_asydcfstq'[nationality_code] <> "EXT_EU27_2020")
			        ),
			    CALCULATE(
			        SUM('fact_asydcfstq'[decision_count]),
			        'fact_asydcfstq'[decision] = "POS",
			        'fact_asydcfstq'[country_code] = "EU27_2020",
			        'fact_asydcfstq'[nationality_code] = "EXT_EU27_2020"
			    )
			)
		formatString: 0
		lineageTag: f1f90c84-a3c8-4d08-a5b0-b504c7672c47

		changedProperty = Name

	measure 'Recognition Rate %' =
			
			DIVIDE([Positive Decisions], [Total Decisions (Page 3)], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 35958b78-a2a1-431d-8c2d-53a9eace7176

		changedProperty = Name

		changedProperty = FormatString

