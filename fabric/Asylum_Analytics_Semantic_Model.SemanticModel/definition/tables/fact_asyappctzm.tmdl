table fact_asyappctzm
	lineageTag: 19913905-ced7-4d73-9f7e-c0868875afeb
	sourceLineageTag: [gold].[fact_asyappctzm]

	measure 'Total Applications (TOTAL)' =
			
			CALCULATE(
			    SUM('fact_asyappctzm'[applicant_count]),
			    'fact_asyappctzm'[applicant_type] = "TOTAL",
			    'fact_asyappctzm'[country_name] = "European Union - 27 countries",
			    'fact_asyappctzm'[country_code] = "EU27_2020",
			    'fact_asyappctzm'[nationality_code] = "EXT_EU27_2020")
		formatString: 0
		lineageTag: 8e5291fa-630b-46c0-8f94-c9e4c735c6bd

		changedProperty = Name

	measure 'Total Applications (Analytical)' =
			
			CALCULATE(
			    SUM('fact_asyappctzm'[applicant_count]),
			    'fact_asyappctzm'[applicant_type] <> "TOTAL",
			    'fact_asyappctzm'[country_name] <> "European Union - 27 countries",
			    'fact_asyappctzm'[country_code] <> "EU27_2020",
			    'fact_asyappctzm'[nationality_code] <> "EXT_EU27_2020")
		formatString: 0
		lineageTag: b2e12e46-e8a8-45c3-a001-676d8f9b71ee

		changedProperty = Name

	measure 'Total Applications (Country Level)' =
			
			CALCULATE(
			    SUM('fact_asyappctzm'[applicant_count]),
			    'fact_asyappctzm'[applicant_type] = "TOTAL",
			    'fact_asyappctzm'[nationality_code] = "EXT_EU27_2020",
			    KEEPFILTERS('fact_asyappctzm'[country_code] <> "EU27_2020"),
			    KEEPFILTERS('fact_asyappctzm'[country_name] <> "European Union - 27 countries")
			)
		formatString: 0
		lineageTag: 62241cd4-8e3f-432f-b0f7-cd91d074149e

		changedProperty = Name

	measure 'Total Applications (Nationality Level)' =
			
			CALCULATE(
			    SUM('fact_asyappctzm'[applicant_count]),
			    'fact_asyappctzm'[applicant_type] = "TOTAL",
			    'fact_asyappctzm'[country_code] = "EU27_2020",
			    'fact_asyappctzm'[nationality_code] <> "EXT_EU27_2020",
			    'fact_asyappctzm'[nationality_code] <> "TOTAL"
			)
		formatString: 0
		lineageTag: 7105d673-1b09-4f8f-9e63-e23ec69674e6

		changedProperty = Name

	measure 'First-Time Applications' =
			
			CALCULATE(
			    SUM('fact_asyappctzm'[applicant_count]),
			    'fact_asyappctzm'[applicant_type] = "FRST",
			    'fact_asyappctzm'[country_code] = "EU27_2020",
			    'fact_asyappctzm'[nationality_code] = "EXT_EU27_2020"
			)
		formatString: 0
		lineageTag: 505fc92f-d630-405f-ba32-06f5a9c428e0

		changedProperty = Name

	measure 'Subsequent Applications' =
			
			CALCULATE(
			    SUM('fact_asyappctzm'[applicant_count]),
			    'fact_asyappctzm'[applicant_type] = "SSEQ",
			    'fact_asyappctzm'[country_code] = "EU27_2020",
			    'fact_asyappctzm'[nationality_code] = "EXT_EU27_2020"
			)
		formatString: 0
		lineageTag: 19ad3e55-4c94-46fa-a2ba-74db7c5df84a

		changedProperty = Name

	measure 'Applications (Nationality Level)' =
			
			IF(
			    ISFILTERED('fact_asyappctzm'[country_name]),
			    CALCULATE(
			        SUM('fact_asyappctzm'[applicant_count]),
			        'fact_asyappctzm'[applicant_type] = "TOTAL",
			        KEEPFILTERS('fact_asyappctzm'[nationality_code] <> "EXT_EU27_2020"),
			        KEEPFILTERS('fact_asyappctzm'[nationality_code] <> "TOTAL")
			    ),
			    CALCULATE(
			        SUM('fact_asyappctzm'[applicant_count]),
			        'fact_asyappctzm'[applicant_type] = "TOTAL",
			        'fact_asyappctzm'[country_code] = "EU27_2020",
			        KEEPFILTERS('fact_asyappctzm'[nationality_code] <> "EXT_EU27_2020"),
			        KEEPFILTERS('fact_asyappctzm'[nationality_code] <> "TOTAL")
			    )
			)
		formatString: 0
		lineageTag: 4cbf3573-acae-4e31-b4a9-60b36db3a559

		changedProperty = Name

	measure 'Applications (By Type)' = ```
			
			VAR IsCountryFiltered = ISFILTERED('fact_asyappctzm'[country_name])
			VAR IsNationalityFiltered = ISFILTERED('fact_asyappctzm'[nationality_code])
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsCountryFiltered && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asyappctzm'[applicant_count]),
			            'fact_asyappctzm'[applicant_type] IN {"FRST", "SSEQ"},
			            KEEPFILTERS('fact_asyappctzm'[country_code] <> "EU27_2020"),
			            KEEPFILTERS('fact_asyappctzm'[nationality_code] <> "EXT_EU27_2020")
			        ),
			        
			    IsCountryFiltered && NOT(IsNationalityFiltered),
			        CALCULATE(
			            SUM('fact_asyappctzm'[applicant_count]),
			            'fact_asyappctzm'[applicant_type] IN {"FRST", "SSEQ"},
			            KEEPFILTERS('fact_asyappctzm'[country_code] <> "EU27_2020"),
			            'fact_asyappctzm'[nationality_code] = "EXT_EU27_2020"
			        ),
			        
			    NOT(IsCountryFiltered) && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asyappctzm'[applicant_count]),
			            'fact_asyappctzm'[applicant_type] IN {"FRST", "SSEQ"},
			            'fact_asyappctzm'[country_code] = "EU27_2020",
			            KEEPFILTERS('fact_asyappctzm'[nationality_code] <> "EXT_EU27_2020")
			        ),
			        
			    CALCULATE(
			        SUM('fact_asyappctzm'[applicant_count]),
			        'fact_asyappctzm'[applicant_type] IN {"FRST", "SSEQ"},
			        'fact_asyappctzm'[country_code] = "EU27_2020",
			        'fact_asyappctzm'[nationality_code] = "EXT_EU27_2020"
			    )
			)
			```
		formatString: 0
		lineageTag: 1c84c698-1469-432b-b6e5-540c5bb3d012

		changedProperty = Name

