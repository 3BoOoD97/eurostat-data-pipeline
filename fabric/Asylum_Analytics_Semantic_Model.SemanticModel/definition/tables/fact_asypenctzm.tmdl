table fact_asypenctzm
	lineageTag: e470576f-635c-4946-8f0b-34737acd9582
	sourceLineageTag: [gold].[fact_asypenctzm]

	measure 'Total Pending (Latest Month)' = ```
			
			VAR MaxPeriodWithData = 
			    MAXX(
			        FILTER(
			            VALUES('fact_asypenctzm'[time_period]),
			            NOT ISBLANK([Total Pending]) && [Total Pending] > 0
			        ),
			        'fact_asypenctzm'[time_period]
			    )
			RETURN
			CALCULATE(
			    [Total Pending],
			    'fact_asypenctzm'[time_period] = MaxPeriodWithData
			)
			```
		formatString: 0
		lineageTag: d51b0246-830f-45a0-8a7c-daafb3d56754

		changedProperty = Name

	measure 'Total Pending (Analytical)' =
			
			CALCULATE(
			    SUM('fact_asypenctzm'[pending_count]),
			    'fact_asypenctzm'[country_name] <> "European Union - 27 countries",
			    'fact_asypenctzm'[country_code] <> "EU27_2020",
			    'fact_asypenctzm'[nationality_code] <> "EXT_EU27_2020")
		formatString: 0
		lineageTag: 37ae5bb1-58b1-4689-a217-22bd4c252eae

		changedProperty = Name

	measure 'Total Pending' =
			
			VAR IsCountryFiltered = ISFILTERED('fact_asypenctzm'[country_name])
			VAR IsNationalityFiltered = ISFILTERED('fact_asypenctzm'[nationality_code])
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsCountryFiltered && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asypenctzm'[pending_count]),
			            KEEPFILTERS('fact_asypenctzm'[country_code] <> "EU27_2020"),
			            KEEPFILTERS('fact_asypenctzm'[nationality_code] <> "EXT_EU27_2020")
			        ),
			    IsCountryFiltered && NOT(IsNationalityFiltered),
			        CALCULATE(
			            SUM('fact_asypenctzm'[pending_count]),
			            KEEPFILTERS('fact_asypenctzm'[country_code] <> "EU27_2020"),
			            'fact_asypenctzm'[nationality_code] = "EXT_EU27_2020"
			        ),
			    NOT(IsCountryFiltered) && IsNationalityFiltered,
			        CALCULATE(
			            SUM('fact_asypenctzm'[pending_count]),
			            'fact_asypenctzm'[country_code] = "EU27_2020",
			            KEEPFILTERS('fact_asypenctzm'[nationality_code] <> "EXT_EU27_2020")
			        ),
			    CALCULATE(
			        SUM('fact_asypenctzm'[pending_count]),
			        'fact_asypenctzm'[country_code] = "EU27_2020",
			        'fact_asypenctzm'[nationality_code] = "EXT_EU27_2020"
			    )
			)
		formatString: 0
		lineageTag: 1e195e61-8125-4b2c-ab55-4749c77a836a

		changedProperty = Name

	measure Measure
		lineageTag: 161d759f-4f37-40e2-b874-c231068c6794

